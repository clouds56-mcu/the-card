# ---- OS ----
.DS_Store
Thumbs.db
desktop.ini

# ---- Editors / IDE ----
.vscode/
.idea/
*.swp
*.swo
*~
nbproject/

# ---- Firmware build artifacts (ESP-IDF / CMake) ----
build/
**/build/
managed_components/
dependencies.lock
sdkconfig.old
sdkconfig.defaults.old
*.o
*.a
*.obj
*.elf
*.bin
*.hex
*.map

# ---- Python (tooling / scripts) ----
__pycache__/
*.py[cod]
.venv/
venv/
env/

# ---- KiCad / EDA (keep designs + fabrication output; ignore autosave/backup/cache) ----
*.bak
*-bak
*-backup
_autosave-*
*.sch-bak
*.kicad_pcb-bak
*.kicad_sch-bak
*-save.kicad_pcb
*-save.kicad_sch
*-cache.lib
*-rescue.lib
fp-info-cache
*.tsv
*.dcm
hardware/~*.lck

# Generated fabrication, export, and local review artifacts.
/output/
/outputs/
/tmp/
/hardware/tmp/
/hardware/ci-design-review/
/.zcode/
/*.erc

# ---- Node / web (for any companion app later) ----
node_modules/
dist/
.next/

# ---- Secrets / env ----
.env
.env.*
!.env.example

# ---- Misc logs ----
*.log

# ---- easyeda2kicad generated libraries ----
# Keep reviewed 2D symbols/footprints reproducible; ignore fetched 3D models.
hardware/libraries/*
!hardware/libraries/*.kicad_sym
!hardware/libraries/*.pretty/
hardware/libraries/*.pretty/*
!hardware/libraries/*.pretty/*.kicad_mod

# ---- SKiDL temp/output artifacts ----
hardware/skidl_REPL*
hardware/*.erc
hardware/circuit.log
hardware/*_sklib.py
hardware/*.net

# ---- datasheet text extractions (temp verify artifacts) ----
hardware/.verify/

# ---- KiCad user-local project settings ----
hardware/*.kicad_prl
hardware/*.kicad_pcb-bak
hardware/*-backups/
